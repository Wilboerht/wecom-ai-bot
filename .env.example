# 企业微信配置
WECOM_CORP_ID=ww1234567890abcdef
WECOM_AGENT_ID=1000001
WECOM_SECRET=your_secret_here
WECOM_TOKEN=your_token_here
WECOM_ENCODING_AES_KEY=your_43_char_aes_key_here_123456789012

# 微信公众号配置（可选，不接公众号可留空）
WX_APP_ID=wx1234567890abcdef
WX_TOKEN=your_wx_token_here
WX_ENCODING_AES_KEY=your_43_char_wx_aes_key_here_1234567890

# 人工转接 — 接待人员的企微userid
WECOM_SERVICE_USERID=your_userid_here

# DeepSeek AI 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 微信公众号配置（可选，不接公众号可留空）
WX_APP_ID=wx1234567890abcdef
WX_TOKEN=your_wx_token_here
WX_ENCODING_AES_KEY=your_43_char_wx_aes_key_here_1234567890
DEEPSEEK_MODEL=deepseek-chat

# AI 系统提示词
SYSTEM_PROMPT=你是一个专业的智能客服助手，请用简洁、友好的语言回答用户的问题。不要编造不存在的产品信息，如果不清楚请如实告知。

# Redis（可选，留空使用内存模式）
REDIS_URL=redis://localhost:6379/0

# 会话管理
SESSION_TTL=1800

# 日志级别
LOG_LEVEL=INFO
