# 企业微信配置
WECOM_CORP_ID=ww1234567890abcdef
WECOM_AGENT_ID=1000001
WECOM_SECRET=your_secret_here
WECOM_TOKEN=your_token_here
WECOM_ENCODING_AES_KEY=your_43_char_aes_key_here_123456789012

# 微信公众号配置（可选，不接公众号可留空）
WX_APP_ID=wx1234567890abcdef
WX_TOKEN=your_wx_token_here
WX_ENCODING_AES_KEY=your_43_char_wx_aes_key_here_1234567890

# 人工转接 — 接待人员的企微userid
WECOM_SERVICE_USERID=your_userid_here

# DeepSeek AI 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# 单次 AI 回复的最大 token 数（默认 2000，非法值自动回退默认值）
DEEPSEEK_MAX_TOKENS=2000
# 采样温度（0-2，默认 0.3）：低值回复更确定、红线规则更稳；非法值回退默认、越界自动夹取到边界
DEEPSEEK_TEMPERATURE=0.3

# AI 系统提示词
SYSTEM_PROMPT=你是一个专业的智能客服助手，请用简洁、友好的语言回答用户的问题。不要编造不存在的产品信息，如果不清楚请如实告知。

# Redis（可选，留空使用内存模式；内存模式重启会丢失会话/档案/隐私授权，
# KF 可靠队列也会退化为进程内队列）
REDIS_URL=redis://localhost:6379/0

# 人工服务时间（周一至周五，小时范围）
SERVICE_START_HOUR=10
SERVICE_END_HOUR=20

# 会话管理
SESSION_TTL=1800

# 非微信客服（公众号/企微应用普通消息）AI 自动回复。
# 默认 0：不处理客户文本，仅保留事件/回调能力；该路径目前没有隐私声明、
# 限流和微信被动回复长度保护，启用前请先补齐相关能力。
NON_KF_AUTO_REPLY_ENABLED=0

# 客服账号配置文件（默认 kf_accounts.json）
# KF_ACCOUNTS_FILE=kf_accounts.json

# 日志级别
LOG_LEVEL=INFO

# 测肤报告联动（enter_session → scene_param → 拉取报告写档案）
# INTERNAL_API_KEY 需与 skin-advisor 子站保持一致（openssl rand -hex 24 生成）
INTERNAL_API_KEY=
ADVISOR_REPORT_API_URL=https://your-advisor-domain.example.com/api/internal/report-summary
KF_ADVISOR_OPEN_KFID=your_advisor_open_kfid_here
KF_SCENE=advisor
KF_SEND_WELCOME=1
