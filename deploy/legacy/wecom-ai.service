[Unit]
Description=NIHPLOD AI 智能客服
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/wecom-ai-bot
ExecStart=/opt/wecom-ai-bot/venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
EnvironmentFile=/opt/wecom-ai-bot/.env
NoNewPrivileges=yes
ProtectSystem=full
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
